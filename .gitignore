# 依赖与包管理器缓存
node_modules/
.pnpm-store/
.swc/

# 构建产物：dist 是静态版，dist-tauri 是桌面壳的前端产物
dist/
dist-tauri/
**/build/

# 桌面壳的 Rust 编译产物（数 GB），.gitignore 已写在 desktop/src-tauri/ 内，这里再兜一层
desktop/src-tauri/target/
desktop/src-tauri/gen/schemas/

# 交付包：绿色版 exe 与可直接分发的 zip，几十 MB，不入库
dist-package/
*.zip

# 截图/回归产物。design/screenshots/ 是产品展示图，要跟着源码入库，只忽略根目录的临时截图
/screenshots/
/shots-daily/
/shots-check/
.tmp-shots/

# 小程序侧的数据层产物：由 pnpm build:core 从 src/data 生成，唯一来源在 src
/miniapp/lib/

# 微信开发者工具的本地私有配置：记录本机基础库版本与编译开关，每台机器都会重写
/miniapp/project.private.config.json

# 本机开发环境与证书，不入库
.env
.env.local
certs/
.DS_Store

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
