.nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 20;
  background: var(--chrome);
}

.nav-inner {
  height: 88rpx;
  padding-left: var(--gap-md);
  /* 右上角是微信的系统胶囊（约 174rpx 宽），右侧动作必须让开，
   * 否则「概览 ›」会被压在胶囊底下 */
  padding-right: 190rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 返回键做 88rpx 见方，再用负外边距把视觉位置收回左缘 ——
 * 点得准，又不让标题被顶到中间 */
.nav-back {
  width: 88rpx;
  height: 88rpx;
  margin-left: -20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--chrome-text);
  font-size: 44rpx;
  line-height: 1;
}

.nav-back:active {
  opacity: 0.7;
}

/* 品牌字：衬线。字形与正文拉开差别，读起来是名字而不是一行界面文字 */
.nav-brand {
  color: var(--chrome-text);
  font-family: var(--font-brand);
  font-size: 38rpx;
  letter-spacing: 0.04em;
  line-height: 1;
}

.nav-title {
  color: var(--chrome-text);
  font-size: var(--fs-body);
  font-weight: 600;
}

.nav-action {
  min-width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--chrome-muted);
  font-size: var(--fs-meta);
}

.nav-action:active {
  color: var(--chrome-text);
}
