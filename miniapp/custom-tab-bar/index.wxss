.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-start;
  background: var(--chrome);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  flex: 1 1 0;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 胶囊而不是下划线：深青底上一条 2px 的线太细，看着像没选中 */
.tab-label {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-control);
  color: var(--chrome-faint);
  font-size: 26rpx;
  line-height: 1.3;
}

/* 选中：浅青实心胶囊 + 深青字。
 * 之前试过「深一档底色」，在 #0e2228 上差 1.2:1，等于没选中；
 * 反相之后一眼就能找到当前页。 */
.tab.is-on .tab-label {
  background: var(--chrome-accent);
  color: var(--chrome);
  font-weight: 600;
}
