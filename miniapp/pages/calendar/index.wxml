<nav-bar action="概览 ›" bind:action="onOverview" />

<view class="page" style="padding-top: {{navHeight}}px; padding-bottom: {{tabBarHeight}}px">
  <view class="paper sheet">
    <!-- 月份条：区间比月份更重要，所以单独占一行 -->
    <view class="month-row">
      <view class="month-step" bindtap="onStep">‹</view>
      <text class="month-title">{{month.title}}</text>
      <view class="month-step" bindtap="onStep">›</view>
    </view>
    <view class="meta-row">
      <text class="range">{{month.range}} · {{month.days}} 天</text>
      <text class="who">{{profile.name}} · {{profile.pattern}} · {{profile.position}}</text>
    </view>

    <!-- 今日卡：整页唯一的暗块，扫视第一眼落在这里 -->
    <view class="today-card">
      <text class="today-label">今天 · {{today.date}} {{today.weekday}}</text>
      <view class="today-main">
        <text class="today-shift">{{today.shift}}</text>
        <text class="today-time">{{today.time}}</text>
      </view>
      <view class="today-foot">
        <text wx:if="{{today.overtime}}" class="flag flag-ot">+{{today.overtime}}h 加班</text>
        <text wx:if="{{today.legal}}" class="flag flag-legal">法定</text>
        <text class="today-todo">{{today.todos}} 项待办</text>
      </view>
    </view>

    <view class="weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</text>
    </view>

    <view class="grid">
      <view
        wx:for="{{cells}}"
        wx:key="key"
        class="cell {{item.inPeriod ? '' : 'is-outside'}} {{item.isToday ? 'is-today' : ''}}"
      >
        <view class="cell-top">
          <text class="cell-day">{{item.day}}</text>
          <view class="cell-flags">
            <text wx:if="{{item.leaveText}}" class="flag flag-leave">{{item.leaveText}}</text>
            <text wx:if="{{item.legal}}" class="flag flag-legal">法</text>
            <text wx:if="{{item.otText}}" class="flag flag-ot">{{item.otText}}</text>
          </view>
        </view>
        <text wx:if="{{item.meta}}" class="cell-meta {{item.isFestival ? 'is-festival' : ''}}">{{item.meta}}</text>
        <view class="cell-shift t-{{item.tone}} {{item.changed ? 'is-changed' : ''}}">{{item.shiftLabel}}</view>
      </view>
    </view>

    <view class="legend">
      <text class="flag flag-ot">+2h</text>
      <text class="legend-text">加班</text>
      <text class="flag flag-legal">法</text>
      <text class="legend-text">法定</text>
      <text class="flag flag-leave">4h</text>
      <text class="legend-text">事假</text>
    </view>
  </view>
</view>
