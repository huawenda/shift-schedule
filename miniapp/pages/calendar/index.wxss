/* 个人日历
 *
 * 尺寸基准：纸面宽 750 − 48 = 702rpx，7 列 → 每列约 100rpx。
 * 格高锁死 112rpx：农历只在节日显示，不锁高会让整行高低不一。
 */

.page {
  min-height: 100vh;
}

.sheet {
  margin: var(--gap-md);
  overflow: hidden;
}

/* ------------------------------------------------------------ 月份条 */

.month-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--gap-md) var(--gap-md) 0;
}

.month-step {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: var(--fs-body);
  line-height: 1;
}

.month-step:active {
  background: var(--active);
  border-radius: var(--radius-control);
}

.month-title {
  margin: 0 var(--gap-sm);
  font-size: var(--fs-section);
  font-weight: 600;
  letter-spacing: -0.02em;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx var(--gap-md) var(--gap-sm);
}

.range {
  color: var(--faint);
  font-size: var(--fs-micro);
}

.who {
  color: var(--muted);
  font-size: var(--fs-micro);
}

/* ------------------------------------------------------------ 今日卡
 * 整页唯一的暗块：白纸上的深青。扫视第一眼就该落在这里。 */

.today-card {
  margin: 0 var(--gap-md) var(--gap-sm);
  padding: var(--gap-md);
  border-radius: var(--radius-block);
  background: var(--chrome);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.today-label {
  color: var(--chrome-faint);
  font-size: var(--fs-micro);
}

.today-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.today-shift {
  color: var(--chrome-text);
  font-size: var(--fs-display);
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1.1;
}

.today-time {
  color: var(--chrome-muted);
  font-size: var(--fs-meta);
  font-variant-numeric: tabular-nums;
}

.today-foot {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  margin-top: 2rpx;
}

.today-todo {
  color: var(--chrome-muted);
  font-size: var(--fs-micro);
}

/* ------------------------------------------------------------ 网格 */

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: var(--gap-sm) 0 var(--gap-xs);
}

.weekday {
  text-align: center;
  color: var(--muted);
  font-size: var(--fs-micro);
}

/* 网格线是「缝」而不是「边框」：给每格加 border，7 × 6 条线在圆角处会露接缝 */
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 2rpx;
  background: var(--rule);
  border-top: 2rpx solid var(--rule);
}

.cell {
  height: 112rpx;
  padding: 8rpx 6rpx;
  background: var(--surface);
  display: flex;
  flex-direction: column;
}

.cell:active {
  background: var(--surface-tint);
}

/* 今天：淡青底 + 强调内描边。线宽写 px —— box-shadow 里的 rpx 不换算，会整条失效 */
.cell.is-today {
  background: var(--accent-weak);
  box-shadow: inset 0 0 0 2px var(--accent);
}

/* 周期外：底色压暗一档 + 内容淡出。仍然显示日号与班次，空格子会被当成渲染失败 */
.cell.is-outside {
  background: var(--active);
}

.cell.is-outside .cell-top,
.cell.is-outside .cell-meta,
.cell.is-outside .cell-shift {
  opacity: 0.35;
}

.cell-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 30rpx;
}

.cell-day {
  color: var(--muted);
  font-size: var(--fs-meta);
  line-height: 30rpx;
  font-variant-numeric: tabular-nums;
}

.cell.is-today .cell-day {
  color: var(--text);
  font-weight: 600;
}

/* 角标最多两枚；20rpx 是能看清的下限 */
.cell-flags {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.cell-meta {
  margin-top: 2rpx;
  color: var(--faint);
  font-size: var(--fs-micro);
  line-height: 1.2;
}

.cell-meta.is-festival {
  color: var(--warning-ink);
}

.cell-shift {
  margin-top: auto;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: var(--radius-sub);
  font-size: var(--fs-control);
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}

/* 描边只表示「与模板不同」：加班、法定各有自己的角标 */
.cell-shift.is-changed {
  box-shadow: inset 0 0 0 1px rgba(19, 20, 22, 0.45);
}

.cell-shift.t-night.is-changed {
  box-shadow: inset 0 0 0 1px rgba(238, 244, 251, 0.55);
}

/* ------------------------------------------------------------ 角标与图例 */

.flag {
  padding: 2rpx 6rpx;
  border-radius: var(--radius-sub);
  font-size: var(--fs-micro);
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}

.flag-ot {
  background: var(--overtime-bg);
  color: var(--overtime-ink);
  font-weight: 700;
}

.flag-legal {
  background: var(--warning-bg);
  color: var(--warning-ink);
}

/* 事假角标：灰底在白格子旁几乎看不出，加一道边把它勾出来 */
.flag-leave {
  background: var(--surface);
  color: var(--muted);
  box-shadow: inset 0 0 0 1px var(--border);
}

.legend {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
  padding: var(--gap-sm) var(--gap-md) var(--gap-md);
  border-top: 2rpx solid var(--rule);
}

.legend-text {
  margin-right: var(--gap-xs);
  color: var(--muted);
  font-size: var(--fs-micro);
}
