page {
  background: var(--surface);
}

.page {
  min-height: 100vh;
  padding: var(--gap-md);
  box-sizing: border-box;
}

/* ------------------------------------------------------------ 分段 */

.seg {
  display: flex;
  gap: var(--gap-xs);
  margin: var(--gap-md) 0 var(--gap-sm);
}

.seg-item {
  flex: 1 1 0;
  height: 68rpx;
  line-height: 64rpx;
  text-align: center;
  border: 2rpx solid var(--border);
  box-sizing: border-box;
  border-radius: var(--radius-control);
  color: var(--muted);
  font-size: var(--fs-meta);
}

/* 选中是墨底白字，不用强调色 —— 一页里多处强调会互相抵消 */
.seg-item.is-on {
  background: var(--text);
  border-color: var(--text);
  color: var(--text-inverse);
  font-weight: 600;
}

/* ------------------------------------------------------------ 列表 */

.list {
  padding-bottom: var(--gap-lg);
}

.row {
  min-height: 112rpx;
  padding: var(--gap-sm) var(--gap-xs) var(--gap-sm) 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-md);
  border-bottom: 2rpx solid var(--rule);
}

.list .row:last-child {
  border-bottom: 0;
}

.row:active {
  background: var(--surface-sunken);
}

.row-main {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.row-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.row-title {
  font-size: var(--fs-body);
  font-weight: 600;
  line-height: 1.3;
}

.row-sub {
  color: var(--faint);
  font-size: var(--fs-micro);
  line-height: 1.3;
}

.row-arrow {
  color: var(--control);
  font-size: var(--fs-body);
  line-height: 1;
}

.badge {
  padding: 0 6rpx;
  height: 28rpx;
  line-height: 28rpx;
  border-radius: 6rpx;
  background: var(--accent-weak);
  color: var(--accent);
  font-size: 18rpx;
  font-weight: 600;
}

/* 添加类动作专用：虚线框，不用实心按钮 —— 它不是这一屏的主操作 */
.add-btn {
  margin-top: var(--gap-md);
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border: 2rpx dashed var(--border);
  box-sizing: border-box;
  border-radius: var(--radius-block);
  color: var(--muted);
  font-size: var(--fs-meta);
}

.add-btn:active {
  background: var(--surface-sunken);
}

/* ------------------------------------------------------------ 抽屉 */

.backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 20, 24, 0.26);
}

.sheet {
  width: 100%;
  padding: var(--gap-md);
  padding-bottom: calc(var(--gap-md) + env(safe-area-inset-bottom));
  border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
  background: var(--surface);
  box-shadow: var(--shadow-sheet);
  max-height: 88vh;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--gap-sm);
  border-bottom: 2rpx solid var(--rule);
}

.sheet-title {
  font-size: var(--fs-body);
  font-weight: 600;
}

.sheet-close {
  padding: 4rpx 8rpx;
  color: var(--muted);
  font-size: var(--fs-meta);
}

.field {
  margin-top: var(--gap-md);
}

.field-label {
  display: block;
  margin-bottom: var(--gap-xs);
  color: var(--muted);
  font-size: var(--fs-meta);
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 var(--gap-sm);
  border: 2rpx solid var(--border);
  box-sizing: border-box;
  border-radius: var(--radius-control);
  font-size: var(--fs-body);
}

/* 班序胶囊：横向滚动，13 条内置 + 自定义一屏放不下 */
.chips {
  white-space: nowrap;
}

.chip {
  display: inline-block;
  height: 64rpx;
  line-height: 60rpx;
  padding: 0 var(--gap-md);
  margin-right: var(--gap-xs);
  border: 2rpx solid var(--border);
  box-sizing: border-box;
  border-radius: 999rpx;
  color: var(--muted);
  font-size: var(--fs-meta);
}

.chip.is-on {
  border-color: var(--accent);
  background: var(--accent-weak);
  color: var(--accent);
  font-weight: 600;
}

.switch-row {
  margin-top: var(--gap-lg);
  padding: var(--gap-sm) 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-text {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.switch-label {
  font-size: var(--fs-body);
}

.switch-note {
  color: var(--faint);
  font-size: var(--fs-micro);
}

/* 开关是纯装饰的形态复刻：78 × 46，圆角 999 */
.switch {
  width: 78rpx;
  height: 46rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--control-soft);
  transition: background var(--dur-fast) ease;
}

.switch.is-on {
  background: var(--accent);
}

.knob {
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  background: var(--surface);
  transition: transform var(--dur-fast) ease;
}

.switch.is-on .knob {
  transform: translateX(32rpx);
}

/* ------------------------------------------------------------ 底栏 */

.sheet-foot {
  margin-top: var(--gap-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-sm);
}

.foot-actions {
  display: flex;
  gap: var(--gap-xs);
}

.btn {
  height: 72rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--control);
  box-sizing: border-box;
  border-radius: var(--radius-control);
  background: var(--surface);
  color: var(--text);
  font-size: var(--fs-control);
  font-weight: 600;
}

.btn-primary {
  border-color: var(--text);
  background: var(--text);
  color: var(--text-inverse);
}

.btn-danger {
  padding: 0 8rpx;
  color: var(--danger);
  font-size: var(--fs-control);
}

.is-disabled {
  opacity: 0.45;
}
