<nav-bar back title="人员配置" />

<view class="page" style="padding-top: {{navHeight}}px">
  <view class="seg">
    <view class="seg-item {{tab === 'member' ? 'is-on' : ''}}" data-tab="member" bindtap="onTab">成员 {{members.length}}</view>
    <view class="seg-item {{tab === 'pattern' ? 'is-on' : ''}}" data-tab="pattern" bindtap="onTab">班序 {{patterns.length}}</view>
  </view>

  <view wx:if="{{tab === 'member'}}" class="list">
    <view wx:for="{{members}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onMember">
      <view class="row-main">
        <view class="row-line">
          <text class="row-title">{{item.name}}</text>
          <text wx:if="{{item.isSelf}}" class="badge">本人</text>
        </view>
        <text class="row-sub">{{item.pattern}} · {{item.position}}</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="add-btn" bindtap="onAdd">＋ 添加成员</view>
  </view>

  <view wx:else class="list">
    <view wx:for="{{patterns}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="onPattern">
      <view class="row-main">
        <text class="row-title">{{item.name}}</text>
        <text class="row-sub">{{item.builtin ? '内置' : '自定义'}} · {{item.users}} 人使用</text>
      </view>
      <text class="row-arrow">›</text>
    </view>
    <view class="add-btn is-muted" bindtap="onAdd">＋ 新建班序</view>
  </view>
</view>

<!-- 成员编辑抽屉 -->
<view wx:if="{{editor}}" class="backdrop" bindtap="onClose">
  <view class="sheet" catchtap="onStop">
    <view class="sheet-head">
      <text class="sheet-title">{{editor.mode === 'add' ? '添加成员' : '编辑成员'}}</text>
      <text class="sheet-close" bindtap="onClose">关闭</text>
    </view>

    <view class="field">
      <text class="field-label">姓名</text>
      <input class="input" value="{{editor.name}}" placeholder="必填" bindinput="onNameInput" />
    </view>

    <view class="field">
      <text class="field-label">岗位</text>
      <input class="input" value="{{editor.position}}" placeholder="可空" bindinput="onPositionInput" />
    </view>

    <view class="field">
      <text class="field-label">班序</text>
      <scroll-view class="chips" scroll-x enable-flex>
        <view
          wx:for="{{patterns}}"
          wx:key="id"
          class="chip {{editor.patternId === item.id ? 'is-on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPickPattern"
        >{{item.name}}</view>
      </scroll-view>
    </view>

    <view class="switch-row" bindtap="onToggleSelf">
      <view class="switch-text">
        <text class="switch-label">设为本人</text>
        <text class="switch-note">日历只显示本人</text>
      </view>
      <view class="switch {{editor.isSelf ? 'is-on' : ''}}">
        <view class="knob"></view>
      </view>
    </view>

    <view class="sheet-foot">
      <text class="btn-danger {{canDelete ? '' : 'is-disabled'}}" bindtap="onDelete">删除</text>
      <view class="foot-actions">
        <view class="btn" bindtap="onClose">取消</view>
        <view class="btn btn-primary {{canSave ? '' : 'is-disabled'}}" bindtap="onSave">保存</view>
      </view>
    </view>
  </view>
</view>
