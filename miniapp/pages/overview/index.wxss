.page {
  min-height: 100vh;
  padding: var(--gap-md);
  padding-bottom: var(--gap-xl);
  box-sizing: border-box;
}

.block {
  padding: var(--gap-md);
  margin-bottom: var(--gap-sm);
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: var(--gap-sm);
  border-bottom: 2rpx solid var(--rule);
}

.block-title {
  font-size: var(--fs-body);
  font-weight: 600;
}

.block-note {
  color: var(--muted);
  font-size: var(--fs-micro);
}

/* ------------------------------------------------------------ 班次贴片 */

/* 六格整块铺班次浅底 + 墨色字，格间只留 8rpx 间隙、不画分隔线 */
.slips {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--gap-xs);
  margin-top: var(--gap-sm);
}

.slip {
  padding: var(--gap-sm) var(--gap-md);
  border-radius: var(--radius-block);
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.slip-value {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.slip-label {
  font-size: var(--fs-micro);
  opacity: 0.82;
}

/* 法定不是班次色，用警示色系里最浅的一档，与黄角标同源 */
.t-legal {
  background: var(--warning-bg);
  color: var(--warning-ink);
}

/* ------------------------------------------------------------ 加班分布 */

.ot-row {
  margin-top: var(--gap-md);
}

.ot-top {
  display: flex;
  align-items: baseline;
  gap: var(--gap-sm);
}

.ot-label {
  flex: 1 1 auto;
  font-size: var(--fs-meta);
}

.ot-hours {
  color: var(--muted);
  font-size: var(--fs-micro);
  font-variant-numeric: tabular-nums;
}

.ot-pay {
  min-width: 140rpx;
  text-align: right;
  font-size: var(--fs-meta);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* 条只有 8rpx 高：再高就变成图表，这里只需要「谁占大头」 */
.ot-bar {
  margin-top: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--rule);
  overflow: hidden;
}

.ot-fill {
  height: 100%;
  border-radius: 999rpx;
}

/* 三档用三个色相，不是同一支色的深浅 —— 深浅在小屏上会糊成一片 */
.kind-weekday {
  background: var(--accent);
}

.kind-special {
  background: var(--overtime-bg);
}

.kind-legal {
  background: var(--warning-ink);
}

/* ------------------------------------------------------------ 薪资 */

.money-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 0;
}

.money-label {
  color: var(--muted);
  font-size: var(--fs-meta);
}

.money-value {
  font-size: var(--fs-meta);
  font-variant-numeric: tabular-nums;
}

/* 应发：明细到这里收口。标签退到辅助色，数值升一档 */
.money-row.is-strong {
  margin-top: var(--gap-xs);
  padding: 14rpx 0 10rpx;
  border-top: 2rpx solid var(--border-strong);
}

.money-row.is-strong .money-value {
  font-size: var(--fs-body);
  font-weight: 600;
}

.money-row.is-deduct .money-value {
  color: var(--muted);
}

/* 实发：内缩的结论块。负外边距吃掉卡片内边距再还回去等量 padding，金额列仍对齐 */
.money-row.is-total {
  margin: 8rpx calc(-1 * var(--gap-md)) 0;
  padding: 14rpx var(--gap-md);
  border-radius: var(--radius-block);
  background: var(--accent-weak);
  color: var(--accent);
}

.money-row.is-total .money-value {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--accent);
}
