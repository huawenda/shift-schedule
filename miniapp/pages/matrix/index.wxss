/* 全员矩阵
 *
 * 结构：左侧姓名列固定，右侧 scroll-view 横向。两边的行高都锁 96rpx，
 * 不靠内容撑 —— 一旦某行文字折行，姓名列与格子就会错位。
 */

.page {
  min-height: 100vh;
}

.sheet {
  margin: var(--gap-md);
  overflow: hidden;
}

/* ------------------------------------------------------------ 今日概览 */

.summary {
  display: flex;
  padding: var(--gap-md);
}

.summary-item {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.summary-label {
  color: var(--muted);
  font-size: var(--fs-micro);
}

/* ------------------------------------------------------------ 表格 */

.matrix {
  display: flex;
  border-top: 2rpx solid var(--rule);
}

/* 姓名列 180rpx：姓名单独一行，徽章跟副行走。
 * 姓名与徽章挤同一行时，3 字名会被压成「华…」 —— 姓名在矩阵里是索引，不能被截 */
.names {
  flex: 0 0 180rpx;
  background: var(--surface);
  border-right: 2rpx solid var(--border-strong);
}

/* 表头占位：与右侧日期表头同高，两边行才对得上 */
.names-head {
  height: 64rpx;
}

.name-row {
  height: 96rpx;
  padding: 0 var(--gap-sm);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
}

.name {
  font-size: var(--fs-control);
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.name-sub-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
}

.name-sub {
  color: var(--faint);
  font-size: var(--fs-micro);
  line-height: 1.2;
  white-space: nowrap;
}

/* 本人徽章：只表身份、不表状态，所以用弱强调色而不是六色里的任何一个 */
.badge {
  flex: 0 0 auto;
  padding: 0 6rpx;
  height: 26rpx;
  line-height: 26rpx;
  border-radius: 6rpx;
  background: var(--accent-weak);
  color: var(--accent);
  font-size: 18rpx;
  font-weight: 600;
}

.days {
  flex: 1 1 auto;
  width: 0;
}

.days-inner {
  width: 1736rpx; /* 31 列 × 56rpx */
}

.day-head {
  display: flex;
  height: 64rpx;
}

.day-cell {
  flex: 0 0 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}

/* 今天只标在表头：每格都描边的话，30 列 × 13 行叠出来是全屏最重的一条线 */
.day-cell.is-today {
  background: var(--accent-weak);
  box-shadow: inset 0 -2px 0 var(--accent);
}

.day-num {
  font-size: var(--fs-meta);
  line-height: 1.1;
  color: var(--muted);
  font-variant-numeric: tabular-nums;
}

.day-cell.is-today .day-num {
  color: var(--text);
  font-weight: 600;
}

.day-week {
  font-size: 18rpx;
  line-height: 1.1;
  color: var(--faint);
}

.day-row {
  display: flex;
  height: 96rpx;
}

.pill-cell {
  flex: 0 0 56rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 药丸四边留白统一 4rpx：上下左右同宽，格子怎么变都居中 */
.pill {
  width: 48rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-sub);
  text-align: center;
  font-size: var(--fs-micro);
  font-weight: 600;
}

/* ------------------------------------------------------------ 图例 */

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm) var(--gap-md);
  padding: var(--gap-sm) var(--gap-md) var(--gap-md);
  border-top: 2rpx solid var(--rule);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 6rpx;
  text-align: center;
  font-size: 18rpx;
  font-weight: 600;
}

.legend-text {
  color: var(--muted);
  font-size: var(--fs-micro);
}
