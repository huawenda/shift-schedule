/*
 * 小程序端令牌（rpx）。750rpx = 屏宽。
 *
 * 颜色是桌面 src/styles/tokens.scss 的**同值**：外壳深青、三级线、两级字、六种班次色。
 * 字号 / 间距 / 圆角是**重新定**的：手机屏小、观看距离近，同名字号要小一档，
 * 层级落差反而要更大。只搬判断，不搬 px 数值。
 *
 * 规范见 miniapp/DESIGN.md §3。
 */
page {
  /* ---------------------------------------------------------- 外壳（深青框） */
  --chrome: #0e2228;
  --chrome-raised: #16333b;
  --chrome-line: #27444d;
  --chrome-text: #e9f2f4;
  --chrome-muted: #a3b7bc;
  --chrome-faint: #7f979d;
  --chrome-accent: #7fd2e2;
  /* 深青底上的选中胶囊：14% 在 #0e2228 上几乎看不出，提到 22% 才有「按下去」的感觉 */
  --chrome-weak: rgba(127, 210, 226, 0.22);

  /* ---------------------------------------------------------- 纸面 */
  --surface: #ffffff;
  --surface-tint: #fbfcfd;
  --surface-sunken: #f6f8f9;
  --canvas: #f2f4f6;
  --active: #ebedee;

  /* ---------------------------------------------------------- 线条三级 */
  --border-strong: #c2c9ce;
  --border: #d9dee2;
  --rule: #e8ebee;
  --control: #8f969b;
  --control-soft: #c2c9cd;

  /* ---------------------------------------------------------- 文字两级 */
  --text: #131416;
  --muted: #4c5256;
  --faint: #5d6468;
  --text-inverse: #ffffff;

  --accent: #1b6c80;
  --accent-weak: #eaf2f4;

  /* ---------------------------------------------------------- 六种班次 */
  --shift-day-bg: #dff3ff;
  --shift-day-ink: #02689f;
  --shift-night-bg: #1e3a5f;
  --shift-night-ink: #eef4fb;
  --shift-rest-bg: #dcfce7;
  --shift-rest-ink: #047857;
  --shift-dayx-bg: #fff0c2;
  --shift-dayx-ink: #b45309;
  --shift-nightx-bg: #fde7c7;
  --shift-nightx-ink: #9a3412;
  --shift-leave-bg: #e5e7eb;
  --shift-leave-ink: #475467;

  /* ---------------------------------------------------------- 功能色 */
  --warning-bg: #fffbeb;
  --warning-ink: #92400e;
  --warning-border: #fde68a;
  --overtime-bg: #ffc98f;
  --overtime-ink: #7a3f0a;
  --danger: #b42318;
  --danger-weak: #fdecea;

  /* ---------------------------------------------------------- 字号七档 */
  /* 64 今日班次名 / 44 全屏页标题 / 36 月份与分区 / 30 正文 /
   * 28 按钮控件与格内班次 / 24 说明副行与日号 / 20 农历角标图例 */
  --fs-display: 64rpx;
  --fs-title: 44rpx;
  --fs-section: 36rpx;
  --fs-body: 30rpx;
  --fs-control: 28rpx;
  --fs-meta: 24rpx;
  --fs-micro: 20rpx;

  /* ---------------------------------------------------------- 间距五档 */
  --gap-xs: 8rpx;
  --gap-sm: 16rpx;
  --gap-md: 24rpx;
  --gap-lg: 32rpx;
  --gap-xl: 48rpx;

  /* ---------------------------------------------------------- 圆角五档 */
  --radius-sub: 8rpx;
  --radius-control: 12rpx;
  --radius-block: 16rpx;
  --radius-card: 24rpx;
  --radius-sheet: 32rpx;

  /* ---------------------------------------------------------- 投影 */
  --shadow-card: 0 4rpx 16rpx rgba(2, 10, 13, 0.05), 0 1rpx 4rpx rgba(2, 10, 13, 0.03);
  --shadow-sheet: 0 -8rpx 32rpx rgba(2, 10, 13, 0.1);

  /* 品牌字：衬线。手机上没有 Noto Serif SC，回退到系统宋体；
   * 每一档都还是衬线，缺字体只会换一款宋，不会跳回黑体。 */
  --font-brand: "Songti SC", "Noto Serif SC", "STZhongsong", "SimSun", serif;

  --dur-fast: 120ms;
  --dur-base: 180ms;
}
