{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "倒班表",
  "mainBinaryName": "倒班表",
  "version": "1.0.0",
  "identifier": "com.huawenda.shiftschedule",

  "build": {
    "beforeDevCommand": "pnpm exec vite --config desktop/vite.config.ts",
    "devUrl": "http://127.0.0.1:6182/index.html",
    "beforeBuildCommand": "pnpm exec vite build --config desktop/vite.config.ts",
    "frontendDist": "../../dist-tauri"
  },

  "app": {
    "windows": [
      {
        "title": "倒班表 · 本地版",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": false
      }
    },
    "withGlobalTauri": true
  },

  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "倒班表 · 本地版",
    "category": "Productivity",
    "shortDescription": "倒班排班、加班统计与薪资计算",
    "longDescription": "纯本地运行的倒班表：排班、加班统计与薪资计算，数据只存在本机，不做任何网络请求。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
