{
  "name": "shift-schedule-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=18"
  },
  "description": "昼夜 · 个人倒班记录本：无登录、无鉴权、无任何网络请求，数据只存在本机浏览器",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:open": "node scripts/dev.mjs --open",
    "dev:lan": "node scripts/dev.mjs --lan",
    "build": "node scripts/build-guides.mjs && tsc --noEmit && vite build",
    "guides": "node scripts/build-guides.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 6181",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:tauri": "node scripts/verify-tauri-shell.mjs",
    "shoot:showcase": "node scripts/shoot-showcase.mjs",
    "shoot:check": "node scripts/shoot-showcase.mjs --check",
    "miniapp:dev": "pnpm -C miniapp-uni dev:mp-weixin",
    "miniapp:build": "pnpm -C miniapp-uni build:mp-weixin",
    "verify:miniapp-uni": "node scripts/verify-miniapp-uni.mjs",
    "desktop:dev": "tauri dev --config desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tsc --noEmit && tauri build --config desktop/src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "sass": "^1.95.1",
    "typescript": "^5.9.3",
    "vite": "^4.5.14",
    "vitest": "^0.34.6"
  }
}
