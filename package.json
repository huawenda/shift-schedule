{
  "name": "shift-schedule-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "倒班表 Web/PWA 主线与小程序旁支",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:web": "pnpm --filter @shift-schedule/web dev",
    "dev:web:https": "node scripts/dev-web-https.mjs",
    "build:web": "pnpm --filter @shift-schedule/web build",
    "preview:web": "pnpm --filter @shift-schedule/web preview",
    "typecheck:web": "pnpm --filter @shift-schedule/web typecheck",
    "dev:weapp": "pnpm --filter @shift-schedule/miniapp dev:weapp",
    "build:weapp": "pnpm --filter @shift-schedule/miniapp build:weapp",
    "typecheck:miniapp": "pnpm --filter @shift-schedule/miniapp typecheck",
    "test:miniapp": "pnpm --filter @shift-schedule/miniapp test",
    "test:core": "pnpm --filter @shift-schedule/core test",
    "typecheck:core": "pnpm --filter @shift-schedule/core typecheck",
    "typecheck": "pnpm typecheck:miniapp",
    "typecheck:all": "pnpm typecheck:miniapp && pnpm typecheck:core && pnpm typecheck:web",
    "test": "pnpm test:miniapp && pnpm test:core",
    "verify:web": "pnpm typecheck:web && pnpm build:web",
    "verify:miniapp": "pnpm typecheck:miniapp && pnpm test:miniapp && pnpm build:weapp",
    "verify:all": "pnpm typecheck:all && pnpm test && pnpm build:web && pnpm build:weapp"
  }
}
